      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\&quot;theme\&quot;: \&quot;base\&quot;, \&quot;themeVariables\&quot;: {\&quot;primaryColor\&quot;: \&quot;#ffffff\&quot;, \&quot;primaryTextColor\&quot;: \&quot;#000000\&quot;, \&quot;primaryBorderColor\&quot;: \&quot;#000000\&quot;, \&quot;lineColor\&quot;: \&quot;#000000\&quot;, \&quot;secondaryColor\&quot;: \&quot;#ffffff\&quot;, \&quot;tertiaryColor\&quot;: \&quot;#ffffff\&quot;, \&quot;fontFamily\&quot;: \&quot;Arial\&quot;}}}%%\n\nclassDiagram\n\nclass User {\n    &lt;&lt;abstract&gt;&gt;\n    +String userID\n    +String name\n    +String email\n}\n\nclass EmergencyReporter\nclass EmergencyOperator\nclass AmbulanceCrewMember\nclass HospitalStaff\n\nUser &lt;|-- EmergencyReporter\nUser &lt;|-- EmergencyOperator\nUser &lt;|-- AmbulanceCrewMember\nUser &lt;|-- HospitalStaff\n\nclass Emergency {\n    +String incidentID\n    +String location\n    +String description\n    +DateTime dateTime\n    +EmergencyType type\n    +Severity severity\n    +int numberOfPatients\n    +EmergencyStatus status\n    +changeStatus()\n    +canBeClosed() bool\n}\n\nclass Patient {\n    +String patientID\n    +MedicalSpecialty requiredSpecialty\n}\n\nclass Dispatch {\n    +String dispatchID\n    +DateTime assignedAt\n}\n\nclass HospitalTransfer {\n    +String transferID\n    +DateTime transferTime\n}\n\nclass Ambulance {\n    +String ambulanceID\n    +AmbulanceStatus status\n}\n\nclass AmbulanceTeam {\n    +String teamID\n}\n\nclass Hospital {\n    +String hospitalID\n    +String name\n    +int freeBeds\n    +int emergencyCapacity\n    +List specialties\n    +isSuitableFor() bool\n    +reserveBeds()\n    +updateAvailability()\n}\n\nclass EmergencyManager {\n    +reportEmergency()\n    +verifyEmergency()\n    +closeEmergency()\n}\n\nclass DispatchManager {\n    +assignAmbulance()\n    +checkAvailableAmbulances()\n}\n\nclass HospitalManager {\n    +searchSuitableHospitals()\n    +selectHospital()\n    +transferPatients()\n}\n\nclass AuthenticationService {\n    +login()\n    +checkRole()\n}\n\nclass EmergencyStatus {\n    &lt;&lt;enumeration&gt;&gt;\n    REPORTED\n    VERIFIED\n    RESPONDING\n    ON_SCENE\n    RESOLVED\n    CLOSED\n}\n\nclass Severity {\n    &lt;&lt;enumeration&gt;&gt;\n    LOW\n    MEDIUM\n    HIGH\n    CRITICAL\n}\n\nclass EmergencyType {\n    &lt;&lt;enumeration&gt;&gt;\n    ROAD_ACCIDENT\n    FIRE\n    MEDICAL\n    OTHER\n}\n\nclass AmbulanceStatus {\n    &lt;&lt;enumeration&gt;&gt;\n    AVAILABLE\n    ASSIGNED\n    UNAVAILABLE\n}\n\nclass MedicalSpecialty {\n    &lt;&lt;enumeration&gt;&gt;\n    TRAUMA\n    MEDICAL\n    OTHER\n}\n\nEmergencyReporter \&quot;1\&quot; -- \&quot;0..*\&quot; Emergency : reports\nEmergencyOperator \&quot;0..1\&quot; -- \&quot;0..*\&quot; Emergency : verifies\nEmergency \&quot;1\&quot; -- \&quot;0..\&quot; Patient : contains\nEmergency \&quot;1\&quot; -- \&quot;0..1\&quot; Dispatch : has\nDispatch \&quot;0..*\&quot; -- \&quot;1\&quot; Ambulance : uses\nDispatch \&quot;0..*\&quot; -- \&quot;1\&quot; EmergencyOperator : assigned by\nAmbulanceTeam \&quot;1\&quot; o-- \&quot;2..*\&quot; AmbulanceCrewMember : includes\nAmbulance \&quot;1\&quot; -- \&quot;0..1\&quot; AmbulanceTeam : assigned team\nPatient \&quot;1\&quot; -- \&quot;0..1\&quot; HospitalTransfer : transferred through\nHospitalTransfer \&quot;0..*\&quot; -- \&quot;1\&quot; Hospital : received by\nHospitalStaff \&quot;1..*\&quot; -- \&quot;1\&quot; Hospital : manages\n\nEmergencyManager ..&gt; Emergency\nDispatchManager ..&gt; Dispatch\nDispatchManager ..&gt; Ambulance\nHospitalManager ..&gt; Hospital\nHospitalManager ..&gt; HospitalTransfer\nEmergencyManager ..&gt; AuthenticationService\nDispatchManager ..&gt; AuthenticationService\nHospitalManager ..&gt; AuthenticationService\n\nEmergency ..&gt; EmergencyStatus\nEmergency ..&gt; Severity\nEmergency ..&gt; EmergencyType\nAmbulance ..&gt; AmbulanceStatus\nPatient ..&gt; MedicalSpecialty\nHospital ..&gt; MedicalSpecialty\n\nclassDef default fill:#ffffff,stroke:#000000,color:#000000&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ruGutzJt-GgNUNTFilXY-161">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10 10 10 870;" vertex="1">
